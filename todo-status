#!/bin/sh
# Usage: todo-status [--all] [-f FILE] [-l | -p | --check | --pretty] [SECTION]
#
# Summarize a TODO.md: per-section ("## " heading) open/done counts and the
# incomplete items by default. --all also includes completed items. Items are
# marked with an empty box (☐) or checked box (☑), titled by their **bold lead**
# (else the first line,
# truncated). An item tagged "(due YYYY-MM-DD)" anywhere in its text shows the
# date, plus OVERDUE once it has passed. "(p1)" / "(p3)" mark high / low
# priority; untagged items count as p2 (normal). "[bug]" etc. is the item's
# category: bug feature refactor docs test chore perf, extended per file by a
# "Categories: word ..." line above the first "## " heading.
#
# SECTION prints one project's full text instead: a number ("3") matches
# "## 3.", anything else is a case-insensitive substring of the heading.
#
# Options:
# --all includes both incomplete and completed items in every view.
# -f FILE selects a checklist; defaults to TODO.md at the Git root, else ./TODO.md.
# -l lists selected items as tab-separated rows for other tools (todo-fzf):
#   start-line  end-line  section  title  due  overdue(0/1)  priority(1-3)  category  done(0/1)  checkbox
#   The original first eight columns are preserved; status columns are appended.
# -p prints the resolved TODO.md path.
# --check lists selected items without an explicit (pN) or a [category] as
# FILE:LINE lines and exits 1 if there are any.
# --pretty prints the overview with color, checkboxes, priority markers and
# aligned columns; with SECTION, that section only. NO_COLOR disables ANSI.
# Unchecked boxes are dim white; checked boxes are green.
# -h, --help shows this help. -v, --version prints the Harmonic version.
#
# Examples:
#   ./todo-status --pretty              # Incomplete work with priorities
#   ./todo-status --all --pretty        # Include completed work with ☑
#   ./todo-status --all "SAM Audio"     # Full matching section text
#   ./todo-status --all --check         # Audit priorities/categories on all tasks
#
# TODO_TODAY=YYYY-MM-DD overrides today's date (tests).

file='' mode='' all=0
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
while [ $# -gt 0 ]; do
  case $1 in
    --all) all=1; shift ;;
    -f) [ $# -ge 2 ] || { echo 'todo-status: -f requires a file' >&2; exit 2; }; file=$2; shift 2 ;;
    -l | -p | --check | --pretty) mode=$1; shift ;;
    -h | --help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
    -v | --version) sed -n 's/^__version__ = "\([^"]*\)"/todo-status \1/p' "$here/src/harmonic_analysis/__init__.py"; exit 0 ;;
    --) shift; break ;;
    -*) echo "todo-status: unknown option $1 (see --help)" >&2; exit 2 ;;
    *) break ;;
  esac
done
section=${1:-}

if [ -z "$file" ]; then
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=.
  file=$top/TODO.md
fi
[ -r "$file" ] || { echo "todo-status: no readable $file" >&2; exit 1; }
[ "$mode" = -p ] && { printf '%s\n' "$file"; exit 0; }

if [ -n "$section" ] && [ -z "$mode" ]; then
  awk -v want="$section" -v all="$all" '
    BEGIN { num = (want ~ /^[0-9]+$/); want = tolower(want) }
    /^ ? ? ?(```+|~~~+)/ {
      marker = $0; sub(/^ */, "", marker); rest = marker; sub(/^`+|^~+/, "", rest)
      size = length(marker) - length(rest); char = substr(marker, 1, 1)
      if (fence == "") { if ($0 !~ /^[ \t]/) hidden = 0; fence = char; fence_size = size }
      else if (char == fence && size >= fence_size && rest ~ /^[ \t]*$/) fence = ""
      if (on && !hidden) print
      next
    }
    fence != "" { if (on && !hidden) print; next }
    /^## / {
      head = substr($0, 4)
      on = num ? (index(head, want ".") == 1) : (index(tolower(head), want) > 0)
      if (on) found = 1
      hidden = 0
    }
    on && /^- \[[xX]\] / { hidden = !all; if (!hidden) { sub(/^- \[[xX]\] /, "- ☑ "); print }; next }
    on && /^- \[ \] / { hidden = 0; sub(/^- \[ \] /, "- ☐ "); print; next }
    on && hidden && /^[ \t]*$/ { next }
    on && hidden && /^[ \t]/ { next }
    on { hidden = 0; print }
    END { if (!found) { print "todo-status: no section matching \"" want "\"" > "/dev/stderr"; exit 1 } }
  ' "$file"
  exit
fi

color=1
[ "${NO_COLOR+x}" = x ] && color=0
awk -v today="${TODO_TODAY:-$(date +%F)}" -v list="$([ "$mode" = -l ] && echo 1)" -v all="$all" -v color="$color" \
  -v check="$([ "$mode" = --check ] && echo 1)" -v file="$file" \
  -v pretty="$([ "$mode" = --pretty ] && echo 1)" -v want="$section" '
  function prettyline(d, p, c, t, due,  box, mark, when) {
    if (length(t) > 64) t = substr(t, 1, 63) "…"
    box = d ? G "☑" R : W "☐" R
    mark = d ? DIM "P" p R : p == 1 ? RED "● P1" R : p == 3 ? DIM "○ P3" R : YEL "● P2" R
    when = due == "" ? "" : (due < today && !d ? "  " RED "due " due " OVERDUE" R : "  " YEL "due " due R)
    if (d) return sprintf("   %s  %s  %s%-9s%s %s%s%s", box, mark, DIM, (c == "" ? "-" : c), R, DIM, t, R)
    return sprintf("   %s  %s  %s%-9s%s %s%s", box, mark, CYAN, (c == "" ? "-" : c), R, t, when)
  }
  function bar(d, n,  i, b, f) {
    f = n ? int(d * 10 / n + 0.5) : 0
    for (i = 1; i <= 10; i++) b = b (i <= f ? G "■" : DIM "□")
    return b R
  }
  BEGIN {
    R = "\033[0m"; G = "\033[32m"; W = "\033[2;37m"; RED = "\033[1;31m"; YEL = "\033[33m"; DIM = "\033[2m"; CYAN = "\033[36m"; HEAD = "\033[1;34m"; B = "\033[1m"
    if (!color) R = G = W = RED = YEL = DIM = CYAN = HEAD = B = ""
    wantnum = (want ~ /^[0-9]+$/); want = tolower(want)
  }
  BEGIN { ncat = split("bug feature refactor docs test chore perf", cats, " "); for (i = 1; i <= ncat; i++) iscat[cats[i]] = 1 }
  # First [word] in the item whose word is a known category, else "".
  function category(t,  w) {
    while (match(t, /\[[a-z][a-z0-9-]*\]/)) {
      w = substr(t, RSTART + 1, RLENGTH - 2)
      if (w in iscat) return w
      t = substr(t, RSTART + RLENGTH)
    }
    return ""
  }
  function title(t) {
    if (match(t, /^\*\*[^*]+\*\*/)) return substr(t, 3, RLENGTH - 4)
    return list || length(t) <= 90 ? t : substr(t, 1, 87) "..."
  }
  # Emit the buffered item, once its continuation lines are all in.
  function flush(  due, tag, prio, explicit, cat, i, missing) {
    if (item == "") return
    if (want != "" && !wanted[nsec]) { item = ""; return }
    tag = due = ""
    explicit = match(body, /\(p[123]\)/)
    prio = explicit ? substr(body, RSTART + 2, 1) + 0 : 2
    if (!isdone) nprio[prio]++
    cat = category(body)
    if (!isdone) ncount[cat]++
    if (cat != "" && (i = index(item, "[" cat "]"))) {
      item = substr(item, 1, i - 1) substr(item, i + length(cat) + 2); gsub(/  +/, " ", item); sub(/^ +/, "", item); sub(/ +$/, "", item)
    }
    if (check) {
      missing = (explicit ? "" : "priority") (explicit || cat != "" ? "" : ", ") (cat != "" ? "" : "category")
      if (missing != "") { printf "%s:%d: missing %s: %s\n", file, start, missing, item; bad++ }
      item = ""
      return
    }
    if (cat != "") tag = "  [" cat "]"
    if (match(body, /\(due [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\)/)) {
      due = substr(body, RSTART + 5, 10)
      tag = tag "  [due " due (due < today && !isdone ? ", OVERDUE" : "") "]"
      if (due < today && !isdone) overdue++
    }
    if (pretty) {
      if (wanted[nsec]) lines[nsec] = lines[nsec] prettyline(isdone, prio, cat, item, due) "\n"
      item = ""
      return
    }
    if (list) {
      printf "%d\t%d\t%s\t%s\t%s\t%d\t%d\t%s\t%d\t%s\n", start, end, heads[nsec], item, due, (due != "" && due < today && !isdone), prio, cat, isdone, (isdone ? "☑" : "☐")
      item = ""
      return
    }
    lines[nsec] = lines[nsec] "  " (isdone ? "☑" : "☐") "  [P" prio "] " item tag "\n"
    item = ""
  }
  !nsec && /^Categories:/ { for (i = 2; i <= NF; i++) if (!($i in iscat)) { iscat[$i] = 1; cats[++ncat] = $i }; next }
  /^ ? ? ?(```+|~~~+)/ {
    if (item != "" && $0 ~ /^[ \t]/) { body = body " " $0; end = NR } else flush()
    marker = $0; sub(/^ */, "", marker); rest = marker; sub(/^`+|^~+/, "", rest)
    size = length(marker) - length(rest); char = substr(marker, 1, 1)
    if (fence == "") { fence = char; fence_size = size }
    else if (char == fence && size >= fence_size && rest ~ /^[ \t]*$/) fence = ""
    next
  }
  fence != "" { if (item != "") { body = body " " $0; if (NF) end = NR }; next }
  /^## / {
    flush(); heads[++nsec] = substr($0, 4)
    wanted[nsec] = want == "" || (wantnum ? index(heads[nsec], want ".") == 1 : index(tolower(heads[nsec]), want) > 0)
    if (wanted[nsec]) anywanted = 1
    next
  }
  /^- \[ \] / { flush(); isdone = 0; item = title(substr($0, 7)); sub(/ *\(p[123]\) */, " ", item); sub(/^ +/, "", item); sub(/ +$/, "", item); body = $0; start = end = NR; open[nsec]++; nopen++; next }
  /^- \[[xX]\] / {
    flush(); done[nsec]++; ndone++
    if (all) { item = title(substr($0, 7)); sub(/ *\(p[123]\) */, " ", item); sub(/^ +/, "", item); sub(/ +$/, "", item); body = $0; start = end = NR; isdone = 1 }
    next
  }
  /^[ \t]/ { if (item != "") { body = body " " $0; if (NF) end = NR }; next }
  /^[^ \t]/ { flush() }
  END {
    flush()
    if (want != "" && !anywanted) { print "todo-status: no section matching \"" want "\"" > "/dev/stderr"; exit 1 }
    if (check) exit bad > 0
    if (list) exit
    if (pretty) {
      if (!anywanted) { print "todo-status: no section matching \"" want "\"" > "/dev/stderr"; exit 1 }
      for (i = 1; i <= nsec; i++) {
        if (!wanted[i] || open[i] + done[i] == 0) continue
        if (!all && open[i] == 0) continue
        printf "%s%s%s%s  %s %s%d/%d%s\n%s", (shown++ ? "\n" : ""), HEAD, heads[i], R, bar(done[i], open[i] + done[i]), DIM, done[i], open[i] + done[i], R, lines[i]
      }
      if (want == "") printf "\n%s%d open%s  %s● P1 %d%s  %s● P2 %d%s  %s○ P3 %d%s  %s☑ %d done%s%s\n", B, nopen, R, RED, nprio[1], R, YEL, nprio[2], R, DIM, nprio[3], R, G, ndone, R, (overdue ? "  " RED overdue " overdue" R : "")
      exit
    }
    for (i = 1; i <= nsec; i++) {
      if (open[i] + done[i] == 0) continue
      if (!all && open[i] == 0) continue
      printf "%s%s  [%d/%d done]\n%s", (shown++ ? "\n" : ""), heads[i], done[i], open[i] + done[i], lines[i]
    }
    if (nopen + ndone) printf "\n%d open (P1 %d, P2 %d, P3 %d), %d done, %d overdue\n", nopen, nprio[1], nprio[2], nprio[3], ndone, overdue
    for (i = 1; i <= ncat; i++) if (ncount[cats[i]]) bycat = bycat (bycat ? ", " : "") cats[i] " " ncount[cats[i]]
    if (ncount[""]) bycat = bycat (bycat ? ", " : "") "uncategorized " ncount[""]
    if (nopen) print "categories: " bycat
  }
' "$file"
