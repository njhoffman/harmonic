#!/usr/bin/env bash
# Usage: todo-fzf [--all] [-f FILE] [--paste PANE] [QUERY...]
#
# Pick incomplete TODO.md items in fzf; --all also includes completed items.
# Rows show ☑ for completed work and ☐ for incomplete work, plus a priority
# marker (P1 red, P2 yellow, P3 dim),
# category, project, title and due date (OVERDUE in red), the item's full text in the
# preview. Rows sort incomplete work before completed work, then by urgency
# (overdue, then priority, then due date, then
# file order); ctrl-s toggles plain file order. QUERY seeds the search ("p1"
# filters by priority, "bug" by category). Items come from `todo-status -l`.
#
# Tab marks several items. Enter prints the marked items (or the current one),
# one "TODO.md:LINE ☑/☐  (Pn) [category] Title" line each; with --paste PANE they are pasted
# into that tmux pane instead (bracketed paste, so nothing is submitted), which
# is how /todo-pop puts them in Claude Code's input. Keys that ~/.fzf/.fzfrc
# binds globally are overridden for these rows: ctrl-e opens the current item
# in $VISUAL/$EDITOR (else nvim, else vi) at its line, ctrl-y copies the marked
# titles, alt-y the marked lines.
#
# The preview is a card per item: project, priority/category/due badges, the
# title, then the item's details rendered as markdown (glow, else bat, else
# plain).
#
# Options:
# --all includes both completed and incomplete tasks (default: incomplete only).
# -f FILE selects another checklist. --paste PANE selects a tmux paste target.
# -h, --help shows this help. -v, --version prints the Harmonic version.
# NO_COLOR disables ANSI styling while preserving checkbox icons.
# Unchecked boxes are dim white; checked boxes are green.
#
# Examples:
#   ./todo-fzf                    # Pick incomplete work
#   ./todo-fzf --all               # Include completed work with ☑
#   ./todo-fzf --all p1            # Search all tasks by priority
#   ./todo-fzf -f TODO.md sam      # Search incomplete SAM-related work
#
# Internal: --rows urgency|file prints the fzf rows; --card LINE prints the
# preview card for the item starting at LINE; --toggle STATE flips the
# order kept in the STATE file and prints the ctrl-s action. (The order lives
# in a file and the header, not the prompt: ~/.fzf/.fzfrc rewrites the prompt
# on every load.)

set -euo pipefail

self=$(readlink -f "$0")
here=${self%/*}
status=(sh "$here/todo-status")
file_args=() mode='' paste=''
while [[ $# -gt 0 ]]; do
  case $1 in
    --all)
      status+=(--all)
      file_args+=(--all)
      shift
      ;;
    -h | --help)
      awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$self"
      exit 0
      ;;
    -v | --version)
      "${status[@]}" --version | sed 's/^todo-status /todo-fzf /'
      exit 0
      ;;
    -f)
      [[ $# -ge 2 ]] || {
        echo 'todo-fzf: -f requires a file' >&2
        exit 2
      }
      status+=(-f "$2")
      file_args+=(-f "$2")
      shift 2
      ;;
    --paste)
      [[ $# -ge 2 ]] || { echo 'todo-fzf: --paste requires a pane' >&2; exit 2; }
      paste=$2
      shift 2
      ;;
    --rows)
      [[ $# -ge 2 ]] || { echo 'todo-fzf: --rows requires an order' >&2; exit 2; }
      mode=rows:$2
      shift 2
      ;;
    --toggle)
      [[ $# -ge 2 ]] || { echo 'todo-fzf: --toggle requires a state file' >&2; exit 2; }
      mode=toggle state=$2
      shift 2
      ;;
    --card)
      [[ $# -ge 2 ]] || { echo 'todo-fzf: --card requires a line number' >&2; exit 2; }
      mode=card:$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "todo-fzf: unknown option $1 (see --help)" >&2
      exit 2
      ;;
    *) break ;;
  esac
done
file=$("${status[@]}" -p)

# How the file is named in the printed lines: relative to the repo top.
top=$(git -C "${file%/*}" rev-parse --show-toplevel 2> /dev/null) || top=${file%/*}
name=${file#"$top"/}

header() { printf 'order: %s   ctrl-s: order  tab: mark  enter: %s  ctrl-e: edit  ctrl-y: copy' "$1" "$([[ -n $paste ]] && echo paste || echo print)"; }

# Fields: start, end, display, plain title, output line. Short project label:
# heading up to its colon, capped at 28 chars.
rows() {
  "${status[@]}" -l | awk -F'\t' -v OFS='\t' -v order="$1" -v name="$name" -v color="${NO_COLOR+x}" '
  BEGIN {
    R="\033[0m"; RED="\033[1;31m"; DIM="\033[2m"; YEL="\033[33m"; CYAN="\033[36m"; BLUE="\033[34m"; GREEN="\033[32m"; WHITE="\033[2;37m"
    if (color != "") R=RED=DIM=YEL=CYAN=BLUE=GREEN=WHITE=""
  }
  {
    proj = $3; sub(/:.*/, "", proj)
    if (length(proj) > 28) proj = substr(proj, 1, 27) "~"
    mark = $9 ? DIM "P" $7 R : $7 == 1 ? RED "P1" R : $7 == 3 ? DIM "P3" R : YEL "P2" R
    box = $9 ? GREEN "☑" R : WHITE "☐" R
    tag = $5 == "" ? "" : ($6 ? "  " RED "[due " $5 ", OVERDUE]" R : "  " ($9 ? DIM : YEL) "[due " $5 "]" R)
    cat = $8 == "" ? "-" : $8
    line = name ":" $1 " " $10 "  (P" $7 ")" ($8 == "" ? "" : " [" $8 "]") " " $4 ($5 == "" ? "" : " [due " $5 "]")
    key = order == "file" ? sprintf("%09d", $1) : sprintf("%d %d %d %s %09d", $9, !$6, $7, ($5 == "" ? "9999-99-99" : $5), $1)
    printf "%s\t%s\t%s\t%s  %s  %s%-8s%s  %s%-28s%s  %s%s\t%s\t%s\n", key, $1, $2, box, mark, CYAN, cat, R, BLUE, proj, R, ($9 ? DIM $4 R : $4), tag, $4, line
  }' | sort | cut -f2-
}

# card LINE: preview for the item whose first line is LINE.
card() {
  local row start end proj title due over prio cat completed box width
  # \x1f as the separator: read merges runs of tabs, which drops empty fields
  row=$("${status[@]}" -l | awk -F'\t' -v OFS=$'\x1f' -v n="$1" '$1 == n { $1 = $1; print }')
  [[ -n $row ]] || return 0
  IFS=$'\x1f' read -r start end proj title due over prio cat completed box <<< "$row"
  width=${FZF_PREVIEW_COLUMNS:-80}
  local R=$'\033[0m' DIM=$'\033[2m' B=$'\033[1m' CYAN=$'\033[36m' RED=$'\033[1;31m' YEL=$'\033[33m'
  [[ ! -v NO_COLOR ]] || {
    R=''
    DIM=''
    B=''
    CYAN=''
    RED=''
    YEL=''
  }
  local mark rule
  case $prio in 1) mark="${RED}● P1 high${R}" ;; 3) mark="${DIM}○ P3 low${R}" ;; *) mark="${YEL}● P2 normal${R}" ;; esac
  printf '%s%s%s\n\n' "$DIM" "$proj" "$R"
  printf '%s %s\n\n' "$box" "$([[ $completed == 1 ]] && echo completed || echo incomplete)"
  printf '%s   %s%s%s' "$mark" "$CYAN" "${cat:-uncategorized}" "$R"
  if [[ -n $due ]]; then
    ((over)) && printf '   %sdue %s OVERDUE%s' "$RED" "$due" "$R" || printf '   %sdue %s%s' "$YEL" "$due" "$R"
  fi
  printf '\n%s%s%s   %s%s:%s%s\n' "$B" "$title" "$R" "$DIM" "$name" "$start" "$R"
  printf -v rule '%*s' "$width" ''
  printf '%s%s%s\n' "$DIM" "${rule// /─}" "$R"
  # Details: the item's text minus the checkbox, bold title and tags,
  # continuation lines dedented, as markdown.
  sed -n "${start},${end}p" "$file" | awk '
    NR == 1 {
      sub(/^- \[[ xX]\] /, ""); sub(/^\*\*[^*]+\*\* */, "")
      gsub(/\(p[123]\) */, ""); gsub(/\(due [0-9-]+\) */, ""); gsub(/\[[a-z][a-z0-9-]*\] */, "")
      if ($0 ~ /[^ ]/) { printf "%s", $0; prev = $0 }
      next
    }
    # Join wrapped lines into paragraphs; list items and blank lines break.
    {
      sub(/^  /, "")
      if ($0 ~ /^[ \t]*([-*+]|[0-9]+\.) / || $0 ~ /^[ \t]*$/ || prev ~ /^[ \t]*$/) { printf "%s%s", (NR > 1 ? "\n" : ""), $0 }
      else { sub(/^[ \t]+/, ""); printf " %s", $0 }
      prev = $0
    }
    END { print "" }' > "$tmp_md"
  if [[ ! -s $tmp_md ]] || ! grep -q '[^[:space:]]' "$tmp_md"; then
    printf '%s(no details)%s\n' "$DIM" "$R"
  elif [[ -v NO_COLOR ]]; then
    cat "$tmp_md"
  elif command -v mdpreview > /dev/null; then
    mdpreview --columns "$width" "$tmp_md"
  elif command -v bat > /dev/null; then
    bat --color=always --style=plain --language=markdown --wrap=auto --terminal-width="$width" "$tmp_md"
  elif command -v glow > /dev/null; then
    glow -s dark -w "$width" - < "$tmp_md" # glow hangs on a file argument here; stdin works
  else
    cat "$tmp_md"
  fi
}

case $mode in
  rows:*)
    rows "${mode#rows:}"
    exit
    ;;
  card:*)
    tmp_md=$(mktemp --suffix=.md)
    trap 'rm -f "$tmp_md"' EXIT
    card "${mode#card:}"
    exit
    ;;
  toggle)
    order=$(cat "$state" 2> /dev/null)
    [[ $order == file ]] && order=urgency || order='file'
    echo "$order" > "$state"
    echo "change-header($(header "$order"))+reload(${self@Q} ${file_args[*]@Q} --rows $order)"
    exit
    ;;
esac

items=$(rows urgency)
[[ -n $items ]] || {
  echo "todo-fzf: no matching tasks in $file (use --all to include completed tasks)" >&2
  exit 1
}

preview="${self@Q} ${file_args[*]@Q} --card {1}"

# $EDITOR can name a shell function (nvim.run), which a script can't run.
read -ra editor <<< "${VISUAL:-${EDITOR:-vi}}"
type -P "${editor[0]}" > /dev/null || editor=("$(type -P nvim || echo vi)")

clip="${here@Q}/clip/pushclip.sh"
state=$(mktemp)
echo urgency > "$state"
picked=$(fzf --ansi --multi --delimiter='\t' --with-nth=3 --no-sort --layout=reverse \
  --prompt='todo> ' --query="$*" --header="$(header urgency)" \
  --preview="$preview" --preview-window='down,40%,wrap,nohidden' \
  --bind="ctrl-s:transform:${self@Q} ${file_args[*]@Q} --toggle ${state@Q}" \
  --bind="ctrl-e:become(${editor[*]@Q} +{1} ${file@Q} </dev/tty >/dev/tty)" \
  --bind="ctrl-y:execute-silent(printf '%s\n' {+4} | $clip)+abort" \
  --bind="alt-y:execute-silent(printf '%s\n' {+5} | $clip)+abort" \
  --bind='alt-_:ignore' \
  <<< "$items" | cut -f5) || true
rm -f "$state"
[[ -n $picked ]] || exit 0

if [[ -n $paste ]]; then
  printf '%s' "$picked" | tmux load-buffer -b todo-fzf -
  tmux paste-buffer -p -d -b todo-fzf -t "$paste"
else
  printf '%s\n' "$picked"
fi
